  "intro": {
    "greeting": "こづゆおばあちゃんじゃ。会津の特別な日の料理、教えっからな。まず、材料を触ってみてけさい。",
    "ingredients": [
      { "label": "干し貝柱", "fact": "干し貝柱は北海道・青森の産。会津も昔から外から買ってきた乾物です。" },
      { "label": "豆麩", "fact": "豆麩（まめふ）は小さな麩。調べた資料のどれでも、麩は最後に入れます。" },
      {
        "label": "里芋",
        "fact": "里芋は、下ゆでして汁を澄ませる家も、そのまま煮てとろみを出す家もあります。"
      },
      { "label": "干し椎茸", "fact": "だしは干し貝柱が中心。干し椎茸の戻し汁も合わせる家が多くあります。" }
    ],
    "words": [
      {
        "word": "けさい",
        "meaning": "「けさい」＝「〜してください」。「見せてけさい」は「見せてください」の意味です。"
      },
      {
        "word": "っせ",
        "meaning": "「っせ」＝「〜してね」。「味わってみっせ」は「味わってみてね」の意味です。"
      },
      { "word": "べ", "meaning": "「べ」＝「〜しよう」。「作るべ」は「作ろう」の意味です。" }
    ]
  },
